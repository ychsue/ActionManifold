{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Python: Current File (module mode)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.vscode/run_as_module.py",
            "console": "integratedTerminal",
            "args": ["${file}"],
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "${file}"
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Python debug cli.py with args",
            "type": "debugpy",
            "request": "launch",
            // "program": "${workspaceFolder}/src/am_core/cli.py",
            "module": "src.am_core.cli",
            // "args": ["roadmap", "--root", "./src/am_core", "--output", "core_roadmap.md"],
            // "args": ["graph", "--root", "./src/am_core"],
            // "args": ["mermaid", "--root", "./am_meta", "--output", "meta_zen_report.md"],
            // "args": ["mermaid", "--root", "./src/am_core", "--pkg_path", "./", "--output", "core_zen_report.md"],
            "args": ["mainline", "--root", "./am_meta", "--pkg_path", "./", "--start", "main_kickoff"],
        }
    ]
}
